# BSI Phuket App - Environment Variables
# Copy this file to .env.local and fill in your values

# ====================
# NEON DATABASE
# ====================
# Get this from your Neon dashboard after creating database
# Format: postgresql://username:password@host/database?sslmode=require
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST.neon.tech/YOUR_DATABASE?sslmode=require"

# ====================
# AUTHENTICATION
# ====================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be at least 32 characters
AUTH_SECRET="REPLACE_WITH_GENERATED_SECRET"

# ====================
# APPLICATION URLS
# ====================
# Development
NEXTAUTH_URL="http://localhost:3000"

# Production (update after deploying to Vercel)
# NEXTAUTH_URL="https://your-app.vercel.app"

# ====================
# NODE ENVIRONMENT
# ====================
NODE_ENV="development"

# ====================
# OPTIONAL: VERCEL ENVIRONMENT
# ====================
# These are automatically set by Vercel, no need to add manually
# VERCEL="1"
# VERCEL_ENV="production"
# VERCEL_URL="your-app.vercel.app"
